const DAYS = (() => {
  const out = [];
  const s = j2d(1405,1,25), e = j2d(1406,3,31);
  for (let d = s; d <= e; d++){
    const j = d2j(d);
    out.push({
      jdn: d, jy: j.jy, jm: j.jm, jd: j.jd,
      key: keyOf(j.jy, j.jm, j.jd),
      wd: weekdayIndex(d)
    });
  }
  return out;
})();


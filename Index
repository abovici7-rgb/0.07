<style>
  :root{
    --bg:#eef2f8;
    --card:#ffffff;
    --ink:#16223a;
    --muted:#6b7a90;
    --line:#e2e8f2;
    --h:#16a34a; --h-bg:#f1fbf5;
    --r:#f59e0b; --r-bg:#fff9ed;
    --s:#3b82f6; --s-bg:#f1f7ff;
    --n:#ef4444; --n-bg:#fef4f3;
    --accent:#4f46e5;
    --radius:14px;
    --shadow:0 1px 2px rgba(20,35,70,.05), 0 8px 24px -12px rgba(20,35,70,.22);
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:"Vazirmatn","IRANSans","Segoe UI",Tahoma,system-ui,sans-serif;
    font-size:14px;
    line-height:1.7;
    padding:16px;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1280px;margin:0 auto;display:flex;flex-direction:column;gap:16px}

  /* ---------- Top bar ---------- */
  .topbar{
    display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
    background:linear-gradient(120deg,#0b1220 0%,#1e2a4a 45%,#4f46e5 100%);
    color:#fff;border-radius:var(--radius);padding:16px 20px;box-shadow:var(--shadow);
    position:relative;overflow:hidden;
  }
  .topbar::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(180deg,rgba(255,255,255,.14),rgba(255,255,255,0) 60%);
    pointer-events:none;
  }
  .brand{display:flex;align-items:center;gap:14px;min-width:0;position:relative;z-index:1}
  .logo{
    width:52px;height:52px;flex:0 0 52px;border-radius:14px;
    background:rgba(255,255,255,.10);
    display:grid;place-items:center;
    border:1px solid rgba(255,255,255,.22);
    overflow:hidden;
  }
  .logo svg{width:34px;height:34px;display:block}
  .brand h1{margin:0;font-size:18px;font-weight:800}
  .brand p{margin:0;font-size:12px;opacity:.75}
  .topactions{display:flex;gap:8px;flex-wrap:wrap;position:relative;z-index:1}
  .btn{
    display:inline-flex;align-items:center;gap:6px;
    background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.22);
    padding:8px 13px;border-radius:10px;cursor:pointer;font:inherit;font-size:13px;
    transition:.15s;user-select:none;
  }
  .btn:hover{background:rgba(255,255,255,.26)}
  .btn:active{transform:translateY(1px)}
  .btn.danger:hover{background:#ef4444;border-color:#ef4444}

  /* ---------- Panels ---------- */
  .panel{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
  .panel-head{
    display:flex;align-items:center;justify-content:space-between;gap:12px;
    padding:14px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap;
  }
  .panel-head h2{margin:0;font-size:15px;font-weight:800}
  .hint{font-size:12px;color:var(--muted)}

  /* ---------- Report cards ---------- */
  .cards{
    display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
    gap:10px;padding:14px 16px;
  }
  .card{
    background:#f8fafc;border:1px solid var(--line);border-radius:12px;
    padding:10px 12px;display:flex;flex-direction:column;gap:2px;position:relative;overflow:hidden;
  }
  .card::after{content:"";position:absolute;inset-inline-start:0;top:0;bottom:0;width:4px;background:#cbd5e1}
  .card[data-tone="h"]::after{background:var(--h)}
  .card[data-tone="r"]::after{background:var(--r)}
  .card[data-tone="s"]::after{background:var(--s)}
  .card[data-tone="n"]::after{background:var(--n)}
  .card .k{font-size:11.5px;color:var(--muted);font-weight:600}
  .card .v{font-size:22px;font-weight:800;letter-spacing:-.5px;font-variant-numeric:tabular-nums}
  .card .sub{font-size:11px;font-weight:700}
  .sub.ok{color:var(--h)}
  .sub.bad{color:var(--n)}
  .sub.zero{color:var(--muted)}

  /* ---------- Monthly chart ---------- */
  .chart{padding:6px 18px 18px;display:flex;flex-direction:column;gap:7px}
  .crow{display:grid;grid-template-columns:110px 1fr 200px;align-items:center;gap:10px}
  .clabel{font-size:12px;font-weight:700;color:#41506a;white-space:nowrap}
  .cbar{height:16px;border-radius:8px;background:#eef2f8;overflow:hidden;display:flex}
  .cbar span{display:block;height:100%}
  .cval{font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap;direction:rtl}

  /* ---------- Toolbar ---------- */
  .toolbar{
    display:flex;gap:10px;align-items:center;flex-wrap:wrap;
    padding:12px 16px;border-bottom:1px solid var(--line);background:#fbfcfe;
  }
  .toolbar input[type="search"], .toolbar select, .set input{
    font:inherit;font-size:13px;padding:7px 11px;border:1px solid var(--line);
    border-radius:10px;background:#fff;color:var(--ink);outline:none;transition:.15s;
  }
  .toolbar input[type="search"]{flex:1;min-width:170px}
  .toolbar input:focus, .toolbar select:focus, .set input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(79,70,229,.12)}
  .legend{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-inline-start:auto;font-size:11.5px;color:var(--muted)}
  .legend i{width:10px;height:10px;border-radius:3px;display:inline-block;margin-inline-end:4px;vertical-align:-1px}
  .mini{
    font:inherit;font-size:12.5px;padding:7px 12px;border-radius:10px;cursor:pointer;
    border:1px solid var(--line);background:#fff;color:#33415c;transition:.15s;
  }
  .mini:hover{border-color:var(--accent);color:var(--accent)}
  .mini.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
  .mini.primary:hover{filter:brightness(1.08);color:#fff}

  /* ---------- Table ---------- */
  .tablewrap{max-height:62vh;overflow:auto;position:relative}
  table{width:100%;border-collapse:separate;border-spacing:0;font-size:13px}
  thead th{
    position:sticky;top:0;z-index:6;background:#f8fafc;
    padding:10px 12px;text-align:right;font-size:12px;font-weight:800;color:#41506a;
    border-bottom:1px solid var(--line);white-space:nowrap;
  }
  td{padding:6px 12px;border-bottom:1px solid var(--line);vertical-align:middle}
  tbody tr{transition:background .12s}
  tbody tr:hover{background:#f6f9ff}
  tr.st-H{background:var(--h-bg)}
  tr.st-R{background:var(--r-bg)}
  tr.st-S{background:var(--s-bg)}
  tr.st-N{background:var(--n-bg)}
  tr.st-H:hover,tr.st-R:hover,tr.st-S:hover,tr.st-N:hover{filter:brightness(.98)}

  .c-date{font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap;width:104px}
  .c-day{color:var(--muted);font-size:12.5px;white-space:nowrap;width:92px}
  .c-seg{width:158px}
  td input{
    width:100%;border:1px solid transparent;background:transparent;border-radius:8px;
    padding:6px 8px;font:inherit;font-size:12.5px;color:var(--ink);outline:none;transition:.15s;
  }
  td input::placeholder{color:#b9c4d4}
  td input:hover{background:rgba(255,255,255,.75);border-color:var(--line)}
  td input:focus{background:#fff;border-color:var(--accent);box-shadow:0 0 0 3px rgba(79,70,229,.12)}

  .seg{display:inline-flex;gap:3px;background:#eaeff7;border-radius:10px;padding:3px}
  .segbtn{
    width:30px;height:26px;border:0;border-radius:7px;background:transparent;
    font:800 13px/1 inherit;color:#63738d;cursor:pointer;transition:.13s;
  }
  .segbtn:hover{background:#dde5f1}
  .segbtn.on[data-s="H"]{background:var(--h);color:#fff;box-shadow:0 2px 6px -2px var(--h)}
  .segbtn.on[data-s="R"]{background:var(--r);color:#fff;box-shadow:0 2px 6px -2px var(--r)}
  .segbtn.on[data-s="S"]{background:var(--s);color:#fff;box-shadow:0 2px 6px -2px var(--s)}
  .segbtn.on[data-s="N"]{background:var(--n);color:#fff;box-shadow:0 2px 6px -2px var(--n)}

  .mhead td{
    background:#eef2f9;font-weight:800;font-size:12.5px;color:#33415c;
    position:sticky;top:41px;z-index:5;padding:7px 12px;
  }
  .mhead .mstats{text-align:left;font-weight:600;color:var(--muted);font-size:11.5px}
  .mhead .mstats b{color:#33415c}

  tr.flash{animation:flash 1.4s ease}
  @keyframes flash{0%{background:#fff3bf}100%{background:transparent}}
  tr.is-today .c-date::after{
    content:"امروز";font-size:10px;font-weight:800;color:#fff;background:var(--accent);
    padding:1px 6px;border-radius:6px;margin-inline-start:6px;
  }

  /* ---------- Settings ---------- */
  details.set{border-top:1px solid var(--line);background:#fbfcfe}
  details.set summary{
    cursor:pointer;padding:11px 18px;font-size:13px;font-weight:700;color:#41506a;
    list-style:none;display:flex;align-items:center;gap:8px;
  }
  details.set summary::-webkit-details-marker{display:none}
  details.set summary::before{content:"⚙";font-size:14px}
  .setgrid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
    gap:12px;padding:4px 18px 18px;
  }
  .setgrid label{display:flex;flex-direction:column;gap:5px;font-size:12px;color:var(--muted);font-weight:600}
  .setgrid input.invalid{border-color:var(--n);box-shadow:0 0 0 3px rgba(239,68,68,.12)}

  /* ---------- Toast ---------- */
  #toast{
    position:fixed;inset-block-end:20px;inset-inline-start:20px;z-index:99;
    background:#16223a;color:#fff;padding:9px 16px;border-radius:10px;font-size:12.5px;
    opacity:0;transform:translateY(8px);transition:.25s;pointer-events:none;box-shadow:var(--shadow);
  }
  #toast.show{opacity:1;transform:translateY(0)}

  .empty{padding:36px;text-align:center;color:var(--muted);font-size:13px}

  @media (max-width:760px){
    body{padding:10px}
    .topbar{padding:14px}
    .brand h1{font-size:15px}
    .crow{grid-template-columns:1fr;gap:4px}
    .cval{text-align:start}
    .legend{display:none}
    .tablewrap{max-height:none}
    .cards{grid-template-columns:repeat(auto-fill,minmax(130px,1fr))}
    thead th,td{padding:6px 8px}
    .c-seg{width:140px}
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- ============ TOP BAR ============ -->
  <div class="topbar">
    <div class="brand">
      <div class="logo" aria-hidden="true">
        <!-- آیکون کلاغ + WSH، هم‌اندازه با لوگوی سربرگ -->
        <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="lg-g" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffffff"/>
              <stop offset="1" stop-color="#c7d2fe"/>
            </linearGradient>
          </defs>
          <g fill="url(#lg-g)">
            <path d="M 248 230 C 200 195 120 165 45 180 C 95 205 155 228 210 248 C 225 254 240 258 248 260 Z"/>
            <path d="M 264 230 C 312 195 392 165 467 180 C 417 205 357 228 302 248 C 287 254 272 258 264 260 Z"/>
            <ellipse cx="256" cy="268" rx="24" ry="36"/>
            <path d="M 238 292 L 256 360 L 274 292 Z"/>
            <circle cx="256" cy="220" r="23"/>
            <path d="M 276 216 L 320 226 L 276 238 Z"/>
          </g>
          <circle cx="263" cy="215" r="3.8" fill="#0b1220"/>
          <text x="256" y="458" font-family="Segoe UI,Inter,Tahoma,sans-serif"
                font-size="122" font-weight="900" letter-spacing="-4"
                text-anchor="middle" fill="#ffffff">WSH</text>
        </svg>
      </div>
      <div>
        <h1>دفتر حضور و گزارش پروژه</h1>
        <p>ثبت روزانه تردد — محاسبه خودکار گزارش‌ها</p>
      </div>
    </div>
    <div class="topactions">
      <button class="btn" id="btnToday">📍 امروز</button>
      <button class="btn" id="btnCsv">⬇ خروجی CSV</button>
      <button class="btn" id="btnExport">💾 پشتیبان JSON</button>
      <label class="btn" for="fileImport">📂 بازیابی</label>
      <input type="file" id="fileImport" accept=".json,application/json" hidden>
      <button class="btn danger" id="btnReset">↺ بازنشانی</button>
    </div>
  </div>

  <!-- ============ REPORTS ============ -->
  <div class="panel">
    <div class="panel-head">
      <h2>📊 گزارش زنده</h2>
      <span class="hint">با هر تغییر، همه محاسبات بلافاصله به‌روز می‌شوند</span>
    </div>

    <div class="cards">
      <div class="card" data-tone="h"><span class="k">تعداد حضور (h)</span><span class="v" id="r-h">0</span></div>
      <div class="card" data-tone="r"><span class="k">تعداد رست (r)</span><span class="v" id="r-r">0</span></div>
      <div class="card" data-tone="s"><span class="k">تعداد سفید (s)</span><span class="v" id="r-s">0</span></div>
      <div class="card" data-tone="n"><span class="k">تردد ناقص (N)</span><span class="v" id="r-n">0</span></div>

      <div class="card"><span class="k">نسبت h به r</span><span class="v" id="r-ratio">0</span></div>
      <div class="card"><span class="k">رست مجاز (h ÷ 2.75)</span><span class="v" id="r-allowed">0</span></div>
      <div class="card"><span class="k">رست‌های وارد شده</span><span class="v" id="r-rests">0</span></div>
      <div class="card" id="card-balance">
        <span class="k">رست طلب‌کاری / بده‌کاری</span>
        <span class="v" id="r-balance">0</span>
        <span class="sub zero" id="r-balance-sub">—</span>
      </div>

      <div class="card"><span class="k">روزهای سپری‌شده در پروژه</span><span class="v" id="r-elapsed">0</span></div>
      <div class="card"><span class="k">درصد حضور</span><span class="v" id="r-pct">0</span></div>
      <div class="card"><span class="k">روزهای گذشته از سربازی</span><span class="v" id="r-milpast">—</span></div>
      <div class="card"><span class="k">روزهای مانده از سربازی</span><span class="v" id="r-milleft">—</span></div>
    </div>

    <div class="chart" id="chart"></div>

    <details class="set">
      <summary>تنظیمات تاریخ‌ها</summary>
      <div class="setgrid">
        <label>تاریخ شروع پروژه
          <input id="setProj" type="text" inputmode="numeric" placeholder="1405/01/25">
        </label>
        <label>تاریخ شروع خدمت (سربازی)
          <input id="setMilStart" type="text" inputmode="numeric" placeholder="1404/11/01">
        </label>
        <label>تاریخ پایان خدمت (سربازی)
          <input id="setMilEnd" type="text" inputmode="numeric" placeholder="1406/02/01">
        </label>
        <label>تاریخ امروز (فقط نمایش)
          <input id="setToday" type="text" readonly>
        </label>
      </div>
    </details>
  </div>

  <!-- ============ TABLE ============ -->
  <div class="panel">
    <div class="toolbar">
      <input type="search" id="search" placeholder="جستجو در تاریخ، توضیح یا فایل‌ها…">
      <select id="filter">
        <option value="all">همه روزها</option>
        <option value="recorded">فقط ثبت‌شده‌ها</option>
        <option value="empty">فقط ثبت‌نشده‌ها</option>
        <option value="H">حضور (h)</option>
        <option value="R">رست (r)</option>
        <option value="S">سفید (s)</option>
        <option value="N">تردد ناقص (N)</option>
      </select>
      <button class="mini" id="btnClearFilter">پاک‌کردن فیلتر</button>
      <div class="legend">
        <span><i style="background:var(--h)"></i>حضور</span>
        <span><i style="background:var(--r)"></i>رست</span>
        <span><i style="background:var(--s)"></i>سفید</span>
        <span><i style="background:var(--n)"></i>ناقص</span>
      </div>
    </div>
    <div class="tablewrap" id="tablewrap">
      <table id="tbl"></table>
    </div>
  </div>

</div>

<div id="toast"></div>

<script>
"use strict";

/* =========================================================
   ۱) ابزارهای تقویم جلالی  (الگوریتم jalaali)
   ========================================================= */
const JAL_BREAKS = [-61,9,38,199,426,686,756,818,1111,1181,1210,1635,2060,2097,2192,2262,2324,2394,2456,3178];
const div = (a,b) => Math.trunc(a/b);
const mod = (a,b) => a - Math.trunc(a/b)*b;

function jalCal(jy){
  const bl = JAL_BREAKS.length;
  const gy = jy + 621;
  let leapJ = -14;
  let jp = JAL_BREAKS[0];
  let jm, jump = 0, leap, leapG, march, n, i;

  for (i = 1; i < bl; i++){
    jm = JAL_BREAKS[i];
    jump = jm - jp;
    if (jy < jm) break;
    leapJ = leapJ + div(jump,33)*8 + div(mod(jump,33),4);
    jp = jm;
  }
  n = jy - jp;
  leapJ = leapJ + div(n,33)*8 + div(mod(n,33)+3,4);
  if (mod(jump,33) === 4 && jump - n === 4) leapJ += 1;
  leapG = div(gy,4) - div((div(gy,100)+1)*3,4) - 150;
  march = 20 + leapJ - leapG;

  if (jump - n < 6) n = n - jump + div(jump+4,33)*33;
  leap = mod(mod(n+1,33)-1, 4);
  if (leap === -1) leap = 4;

  return {leap, gy, march};
}

function g2d(gy, gm, gd){
  let d = div((gy + div(gm-8,6) + 100100) * 1461, 4)
        + div(153 * mod(gm+9,12) + 2, 5)
        + gd - 34840408;
  d = d - div(div(gy + 100100 + div(gm-8,6), 100) * 3, 4) + 752;
  return d;
}
function d2g(jdn){
  let j = 4*jdn + 139361631;
  j = j + div(div(4*jdn + 183187720, 146097) * 3, 4) * 4 - 3908;
  const i  = div(mod(j,1461),4)*5 + 308;
  const gd = div(mod(i,153),5) + 1;
  const gm = mod(div(i,153),12) + 1;
  const gy = div(j,1461) - 100100 + div(8-gm,6);
  return {gy, gm, gd};
}
function j2d(jy, jm, jd){
  const r = jalCal(jy);
  return g2d(r.gy, 3, r.march) + (jm-1)*31 - div(jm,7)*(jm-7) + jd - 1;
}
function d2j(jdn){
  const gy = d2g(jdn).gy;
  let jy = gy - 621;
  const r = jalCal(jy);
  const jdn1f = g2d(gy, 3, r.march);
  let k = jdn - jdn1f;

  if (k >= 0){
    if (k <= 185) return {jy, jm: 1 + div(k,31), jd: mod(k,31) + 1};
    k -= 186;
  } else {
    jy -= 1;
    k += 179;
    if (r.leap === 1) k += 1;
  }
  return {jy, jm: 7 + div(k,30), jd: mod(k,30) + 1};
}
function weekdayIndex(jdn){
  const g = d2g(jdn);
  const dow = new Date(Date.UTC(g.gy, g.gm-1, g.gd)).getUTCDay();
  return (dow + 1) % 7;
}

const WD = ['شنبه','یکشنبه','دوشنبه','سه‌شنبه','چهارشنبه','پنج‌شنبه','جمعه'];
const MONTHS = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];

const pad2 = n => String(n).padStart(2,'0');
const keyOf = (jy,jm,jd) => `${jy}/${pad2(jm)}/${pad2(jd)}`;
function parseKey(k){
  const p = String(k).split('/').map(Number);
  if (p.length !== 3 || p.some(n => !Number.isFinite(n))) return null;
  if (p[1] < 1 || p[1] > 12 || p[2] < 1 || p[2] > 31) return null;
  try { j2d(p[0], p[1], p[2]); } catch(e){ return null; }
  return {jy:p[0], jm:p[1], jd:p[2]};
}


$('tbl').addEventListener('click', e => {
  const btn = e.target.closest('button[data-s]');
  if (!btn) return;
  const tr = btn.closest('tr');
  const key = tr.dataset.date;
  const s = btn.dataset.s;
  const rec = state.days[key] || (state.days[key] = {s:'', d:'', f:''});

  rec.s = (rec.s === s) ? '' : s;

  tr.querySelectorAll('.segbtn').forEach(b => b.classList.toggle('on', b.dataset.s === rec.s));
  updateRowClasses(tr, rec.s);

  const d = DAY_INDEX.get(key);
  if (d) updateMonthHeader(d.jy + '/' + pad2(d.jm));

  refreshReports();
  saveSoon();
});

$('tbl').addEventListener('input', e => {
  const inp = e.target;
  if (!inp.matches('input[data-field]')) return;
  const tr = inp.closest('tr');
  const key = tr.dataset.date;
  const rec = state.days[key] || (state.days[key] = {s:'', d:'', f:''});
  rec[inp.dataset.field] = inp.value;
  saveSoon();
});


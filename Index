function download(content, filename, type){
  const blob = new Blob([content], {type: type || 'text/plain;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 0);
}

$('btnCsv').addEventListener('click', () => {
  const rows = [['تاریخ','روز هفته','وضعیت','توضیح','فایل‌های تحویل‌شده']];
  for (const d of DAYS){
    const r = state.days[d.key] || {s:'', d:'', f:''};
    rows.push([d.key, WD[d.wd], r.s || '', r.d || '', r.f || '']);
  }
  const csv = '\ufeff' + rows.map(r =>
    r.map(c => '"' + String(c).replace(/"/g, '""') + '"').join(',')
  ).join('\r\n');
  download(csv, 'WSH-attendance.csv', 'text/csv;charset=utf-8');
  toast('✓ فایل CSV ساخته شد');
});

$('btnExport').addEventListener('click', () => {
  download(JSON.stringify(state, null, 2), 'WSH-backup.json', 'application/json');
  toast('✓ پشتیبان ذخیره شد');
});

$('fileImport').addEventListener('change', e => {
  const file = e.target.files && e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try{
      const p = JSON.parse(reader.result);
      if (!p || !p.days) throw new Error('bad');
      const base = buildSeedDays();
      const days = {};
      for (const k of Object.keys(base)){
        days[k] = p.days[k]
          ? {s:p.days[k].s||'', d:p.days[k].d||'', f:p.days[k].f||''}
          : base[k];
      }
      for (const k of Object.keys(p.days)){
        if (!days[k]) days[k] = {s:p.days[k].s||'', d:p.days[k].d||'', f:p.days[k].f||''};
      }
      state = {days, settings: Object.assign({}, DEFAULT_SETTINGS, p.settings || {})};
      applyAll();
      saveNow();
      toast('✓ داده‌ها بازیابی شد');
    } catch(err){
      toast('⚠️ فایل نامعتبر است');
    }
    e.target.value = '';
  };
  reader.readAsText(file, 'utf-8');
});

$('btnReset').addEventListener('click', () => {
  if (!confirm('همه تغییرات پاک شود و به داده‌های اولیه فایل اکسل برگردیم؟')) return;
  state = freshState();
  applyAll();
  saveNow();
  toast('↺ بازنشانی شد');
});

/* =========================================================
   ۱۱) راه‌اندازی
   ========================================================= */
function applyAll(){
  $('setProj').value     = state.settings.projStart || '';
  $('setMilStart').value = state.settings.milStart || '';
  $('setMilEnd').value   = state.settings.milEnd || '';
  $('setProj').classList.remove('invalid');
  $('setMilStart').classList.remove('invalid');
  $('setMilEnd').classList.remove('invalid');

  renderTable();
  refreshReports();
}

applyAll();

window.addEventListener('beforeunload', () => { saveNow(); });
</script>

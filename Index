const DEFAULT_SETTINGS = {
  projStart: '1405/01/25',
  milStart:  '1404/11/01',
  milEnd:    '1406/02/01'
};

function freshState(){
  return { days: buildSeedDays(), settings: Object.assign({}, DEFAULT_SETTINGS) };
}

function loadState(){
  try{
    const raw = localStorage.getItem(LS_KEY);
    if (!raw) return freshState();
    const p = JSON.parse(raw);
    if (!p || typeof p !== 'object' || !p.days) return freshState();

    const base = buildSeedDays();
    const days = {};
    for (const k of Object.keys(base)){
      const cur = p.days[k];
      days[k] = cur
        ? {s: cur.s || '', d: cur.d || '', f: cur.f || ''}
        : base[k];
    }
    for (const k of Object.keys(p.days)){
      if (!days[k]) days[k] = {s:p.days[k].s||'', d:p.days[k].d||'', f:p.days[k].f||''};
    }
    return { days, settings: Object.assign({}, DEFAULT_SETTINGS, p.settings || {}) };
  } catch(e){
    return freshState();
  }
}

let state = loadState();


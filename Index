/* =========================================================
   ۴) محاسبه آمار
   ========================================================= */
function computeStats(){
  const c = {H:0, R:0, S:0, N:0};
  let recorded = 0;
  const monthly = new Map();

  for (const d of DAYS){
    const rec = state.days[d.key];
    const mk = d.jy + '/' + pad2(d.jm);
    let m = monthly.get(mk);
    if (!m){
      m = {jy:d.jy, jm:d.jm, H:0, R:0, S:0, N:0, recorded:0};
      monthly.set(mk, m);
    }
    const s = rec && rec.s;
    if (s && c[s] !== undefined){
      c[s]++; recorded++;
      m[s]++; m.recorded++;
    }
  }

  const ratio   = c.R === 0 ? 0 : Math.round((c.H / c.R) * 100) / 100;
  const allowed = Math.floor(c.H / 2.75);
  const balance = (c.R - allowed) * -1;
  const pct     = recorded ? Math.round((c.H / recorded) * 100) : 0;

  return {c, recorded, monthly, ratio, allowed, balance, pct};
}

function todayJdn(){
  const n = new Date();
  return g2d(n.getFullYear(), n.getMonth()+1, n.getDate());
}
function todayKey(){
  const j = d2j(todayJdn());
  return keyOf(j.jy, j.jm, j.jd);
}

/* =========================================================
   ۵) رندر گزارش
   ========================================================= */
const $ = id => document.getElementById(id);

function refreshReports(){
  const st = computeStats();
  const {c} = st;

  $('r-h').textContent = c.H.toLocaleString('en-US');
  $('r-r').textContent = c.R.toLocaleString('en-US');
  $('r-s').textContent = c.S.toLocaleString('en-US');
  $('r-n').textContent = c.N.toLocaleString('en-US');

  $('r-ratio').textContent   = st.ratio.toLocaleString('en-US');
  $('r-allowed').textContent = st.allowed.toLocaleString('en-US');
  $('r-rests').textContent   = c.R.toLocaleString('en-US');
  $('r-elapsed').textContent = st.recorded.toLocaleString('en-US');
  $('r-pct').textContent     = st.pct + '٪';

  const balEl = $('r-balance');
  const balSub = $('r-balance-sub');
  balEl.textContent = Math.abs(st.balance).toLocaleString('en-US');
  balSub.classList.remove('ok','bad','zero');
  if (st.balance > 0){
    balEl.style.color = 'var(--h)';
    balSub.textContent = 'طلب‌کار (رست استفاده‌نشده)';
    balSub.classList.add('ok');
  } else if (st.balance < 0){
    balEl.style.color = 'var(--n)';
    balSub.textContent = 'بده‌کار (رست بیشتر از مجاز)';
    balSub.classList.add('bad');
  } else {
    balEl.style.color = '';
    balSub.textContent = 'متوازن';
    balSub.classList.add('zero');
  }

  const tj = todayJdn();
  const ms = parseKey(state.settings.milStart);
  const me = parseKey(state.settings.milEnd);
  let past = '—', left = '—';
  if (ms){
    try { past = (tj - j2d(ms.jy, ms.jm, ms.jd)).toLocaleString('en-US'); } catch(e){ past = '—'; }
  }
  if (me){
    try { left = (j2d(me.jy, me.jm, me.jd) - tj).toLocaleString('en-US'); } catch(e){ left = '—'; }
  }
  $('r-milpast').textContent = past;
  $('r-milleft').textContent = left;

  $('setToday').value = todayKey();

  renderChart(st.monthly);
}

function renderChart(monthly){
  const host = $('chart');
  const keys = [...monthly.keys()].filter(k => monthly.get(k).recorded > 0);
  if (!keys.length){
    host.innerHTML = '<div class="hint" style="padding:6px 0">هنوز داده‌ای برای نمودار ماهانه ثبت نشده است.</div>';
    return;
  }
  keys.sort((a,b) => {
    const A = monthly.get(a), B = monthly.get(b);
    return (A.jy - B.jy) || (A.jm - B.jm);
  });

  host.innerHTML = keys.map(k => {
    const m = monthly.get(k);
    const segs = STATUS_KEYS
      .filter(s => m[s] > 0)
      .map(s => `<span style="flex:${m[s]};background:${STATUS[s].color}" title="${STATUS[s].label}: ${m[s]}"></span>`)
      .join('');
    const parts = STATUS_KEYS
      .filter(s => m[s] > 0)
      .map(s => `${m[s]} ${STATUS[s].short}`)
      .join(' · ');
    return `<div class="crow">
      <div class="clabel">${MONTHS[m.jm-1]} ${m.jy}</div>
      <div class="cbar">${segs || '<span style="flex:1;background:#e2e8f2"></span>'}</div>
      <div class="cval">${parts || '—'} <span style="color:#b9c4d4">(${m.recorded} روز)</span></div>
    </div>`;
  }).join('');
}

/* =========================================================
   ۶) رندر جدول
   ========================================================= */
const esc = s => String(s)
  .replace(/&/g,'&amp;').replace(/</g,'&lt;')
  .replace(/>/g,'&gt;').replace(/"/g,'&quot;');

function monthStatsOf(list){
  const c = {H:0, R:0, S:0, N:0};
  for (const d of list){
    const s = state.days[d.key] && state.days[d.key].s;
    if (s && c[s] !== undefined) c[s]++;
  }
  return c;
}

function monthStatsHtml(list){
  const c = monthStatsOf(list);
  const parts = STATUS_KEYS
    .filter(s => c[s] > 0)
    .map(s => `<b style="color:${STATUS[s].color}">${c[s]}</b> ${STATUS[s].short}`);
  return parts.length ? parts.join(' &nbsp;·&nbsp; ') + ` &nbsp;|&nbsp; مجموع: <b>${list.length}</b> روز` : '—';
}

function rowHtml(d, tKey){
  const rec = state.days[d.key] || {s:'', d:'', f:''};
  const s = rec.s || '';
  const seg = STATUS_KEYS.map(k =>
    `<button type="button" class="segbtn ${s===k?'on':''}" data-s="${k}" title="${STATUS[k].label}">${STATUS[k].short}</button>`
  ).join('');
  const cls = ['st-' + (s || 'none')];
  if (d.key === tKey) cls.push('is-today');
  return `<tr data-date="${d.key}" class="${cls.join(' ')}">
    <td class="c-date">${d.key}</td>
    <td class="c-day">${WD[d.wd]}</td>
    <td class="c-seg"><div class="seg">${seg}</div></td>
    <td><input data-field="d" value="${esc(rec.d||'')}" placeholder="توضیح…"></td>
    <td><input data-field="f" value="${esc(rec.f||'')}" placeholder="فایل‌های تحویل‌شده…"></td>
  </tr>`;
}

function renderTable(){
  const q = ($('search').value || '').trim().toLowerCase();
  const f = $('filter').value;
  const tKey = todayKey();

  const groups = new Map();
  for (const d of DAYS){
    const rec = state.days[d.key] || {s:'', d:'', f:''};

    if (q){
      const hay = (d.key + ' ' + WD[d.wd] + ' ' + (rec.d||'') + ' ' + (rec.f||'')).toLowerCase();
      if (!hay.includes(q)) continue;
    }
    if (f === 'recorded' && !rec.s) continue;
    if (f === 'empty' && rec.s) continue;
    if (STATUS_KEYS.includes(f) && rec.s !== f) continue;

    const mk = d.jy + '/' + pad2(d.jm);
    if (!groups.has(mk)) groups.set(mk, []);
    groups.get(mk).push(d);
  }

  let html = `<thead><tr>
      <th>تاریخ (شمسی)</th>
      <th>روز هفته</th>
      <th>وضعیت (h/r/s)</th>
      <th>توضیح</th>
      <th>فایل‌هایی که تحویل شده</th>
    </tr></thead>`;

  if (!groups.size){
    html += `<tbody><tr><td colspan="5"><div class="empty">موردی با این فیلتر پیدا نشد.</div></td></tr></tbody>`;
  } else {
    for (const [mk, list] of groups){
      const [jy, jm] = mk.split('/').map(Number);
      html += `<tbody class="mgroup" data-month="${mk}">
        <tr class="mhead">
          <td colspan="2">${MONTHS[jm-1]} ${jy}</td>
          <td colspan="3" class="mstats" data-mstats="${mk}">${monthStatsHtml(list)}</td>
        </tr>`;
      for (const d of list) html += rowHtml(d, tKey);
      html += `</tbody>`;
    }
  }

  $('tbl').innerHTML = html;
}

function updateMonthHeader(mk){
  const el = document.querySelector(`[data-mstats="${mk}"]`);
  if (!el) return;
  const list = DAYS.filter(d => (d.jy + '/' + pad2(d.jm)) === mk);
  el.innerHTML = monthStatsHtml(list);
}

function updateRowClasses(tr, s){
  tr.className = 'st-' + (s || 'none') + (tr.dataset.date === todayKey() ? ' is-today' : '');
}

